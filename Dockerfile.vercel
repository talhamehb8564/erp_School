# Temporary Vercel Container (Fluid) image for the Spring Boot /api/v1 service.
# Listens on $PORT (Vercel default 80). Does not change VPS or local 8080 config.
FROM maven:3.9.9-eclipse-temurin-21-alpine AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S erp && adduser -S erp -G erp
WORKDIR /app
COPY --from=build /src/target/erp-school-*.jar /app/app.jar
RUN mkdir -p /app/uploads && chown -R erp:erp /app
USER erp
ENV PORT=80
ENV JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
EXPOSE 80
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
