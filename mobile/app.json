{
  "expo": {
    "name": "Green Valley School Portal",
    "slug": "school-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./branding/assets/icon.png",
    "scheme": "erpschool",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devzard.schoolerp",
      "icon": "./branding/assets/icon.png"
    },
    "android": {
      "package": "com.devzard.schoolerp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1B365D",
        "foregroundImage": "./branding/assets/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCmakeObjectPathMax.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "cmakeVersion": "3.31.6"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Green Valley School Portal needs photo access to upload homework and payment slips."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B365D",
          "image": "./branding/assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B365D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "school": {
        "name": "Green Valley School",
        "appName": "Green Valley School Portal",
        "code": "GVS",
        "primaryColor": "#1B365D",
        "accentColor": "#C4A35A",
        "tagline": "Portal"
      }
    }
  }
}
